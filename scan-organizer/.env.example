# scan-organizer configuration
# Copy to .env and edit for your setup.

# Directory to watch for unprocessed PDFs (default: ~/scans)
# SCANS_DIR=~/scans

# OpenAI-compatible API base URL (default: local Ollama)
# Works with Ollama, OpenAI, OpenRouter, LM Studio, vLLM, etc.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=

# Classification model (any chat model)
# CLASSIFY_MODEL=qwen3:8b

# Optional fallback model if primary fails (leave empty to disable)
# CLASSIFY_FALLBACK_MODEL=

# OCR vision model (any model supporting image input)
# OCR_MODEL=glm-ocr:latest

# Optional: use a different provider for OCR (falls back to OPENAI_* values)
# OCR_BASE_URL=
# OCR_API_KEY=

# Thresholds
# MIN_PAGE_TEXT_CHARS=50    # pages with fewer chars get OCR'd
# MAX_CLASSIFY_CHARS=28000  # truncate text sent to classifier

# Timeouts (seconds)
# OCR_TIMEOUT=600
# CLASSIFY_TIMEOUT=600
