expanded AS (
    SELECT
        CASE_ID_BASE * 10 + 1 AS CASE_ID,
        CASE_GROUP,
        1 AS VARIANT_ID,
        SUBJECT_V1 AS SUBJECT,
        BODY_V1 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases

    UNION ALL

    SELECT
        CASE_ID_BASE * 10 + 2 AS CASE_ID,
        CASE_GROUP,
        2 AS VARIANT_ID,
        SUBJECT_V2 AS SUBJECT,
        BODY_V2 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases

    UNION ALL

    SELECT
        CASE_ID_BASE * 10 + 3 AS CASE_ID,
        CASE_GROUP,
        3 AS VARIANT_ID,
        SUBJECT_V3 AS SUBJECT,
        BODY_V3 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases

    UNION ALL

    SELECT
        CASE_ID_BASE * 10 + 4 AS CASE_ID,
        CASE_GROUP,
        4 AS VARIANT_ID,
        SUBJECT_V4 AS SUBJECT,
        BODY_V4 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases
)
SELECT
    e.CASE_ID,
    e.CASE_GROUP,
    e.VARIANT_ID,
    e.SUBJECT,
    e.BODY,
    e.CUSTOMER_TIER,
    e.COMPANY_NAME,
    p.POLICY_PROFILE,
    p.POLICY_TEXT,
    p.ENTITLEMENT_TEXT,
    e.DEFAULT_LABEL,
    e.EXPECTED_OUTPUT,
    e.RULE_FAMILY,
    e.POLICY_EFFECT,
    IFF(e.POLICY_EFFECT = 'override', TRUE, FALSE) AS REQUIRES_POLICY_CONTEXT,
    e.CURATION_NOTE,
    CURRENT_TIMESTAMP() AS CURATED_AT
FROM expanded e
JOIN {{ database }}.{{ schema }}.DEMO_COMPANY_ROUTING_POLICY_V6 p USING (COMPANY_NAME)
ORDER BY e.CASE_ID;


SELECT
    'holdout_v6_small' AS dataset,
    COUNT(*) AS row_count,
    COUNT_IF(REQUIRES_POLICY_CONTEXT) AS override_row_count,
    COUNT(DISTINCT CASE_GROUP) AS case_group_count
FROM {{ database }}.{{ schema }}.DEMO_TICKETS_HARD_GOLD_V6_SMALL
UNION ALL
SELECT
    'train_v6_large' AS dataset,
    COUNT(*) AS row_count,
    COUNT_IF(REQUIRES_POLICY_CONTEXT) AS override_row_count,
    COUNT(DISTINCT CASE_GROUP) AS case_group_count
FROM {{ database }}.{{ schema }}.DEMO_TICKETS_POLICY_TRAIN_V6_LARGE;


SELECT
    COUNT(*) AS exact_subject_overlap_count
FROM {{ database }}.{{ schema }}.DEMO_TICKETS_POLICY_TRAIN_V6_LARGE t
JOIN {{ database }}.{{ schema }}.DEMO_TICKETS_HARD_GOLD_V6_SMALL h
    ON t.SUBJECT = h.SUBJECT;


SELECT
    'holdout_v6_small' AS dataset,
    GOLD_LABEL_V6_SMALL AS label,
    COUNT(*) AS row_count
FROM {{ database }}.{{ schema }}.DEMO_TICKETS_HARD_GOLD_V6_SMALL
GROUP BY 1, 2
UNION ALL
SELECT
    'train_v6_large' AS dataset,
    EXPECTED_OUTPUT AS label,
    COUNT(*) AS row_count
FROM {{ database }}.{{ schema }}.DEMO_TICKETS_POLICY_TRAIN_V6_LARGE
GROUP BY 1, 2
ORDER BY dataset, label;
