CREATE OR REPLACE TABLE {{ database }}.{{ schema }}.DEMO_COMPANY_ROUTING_POLICY_V6 AS
SELECT * FROM VALUES
    (
        'ACME_BANK',
        'ledger_and_shield_v6',
        'Acme routes duplicate charges, contradictory fee states, reserve-balance reconciliation, and footprint-downshift credits that keep the core tenant live to the ledger integrity cell. Suspicious links, credential harvests, impossible travel, and unexplained copy rules go to shield response. Existing runtime malfunctions go to runtime reliability.',
        'Acme prepays reserved lab wings. Retiring a reserved lab while the core tenant stays live is treated as reserve reconciliation, not service stop. Courier dispatch, staged approval lanes, and the batch edit console are not on the current Acme order form.'
    ),
    (
        'CONTOSO_HEALTH',
        'annexed_workspace_gatekeeping_v6',
        'Contoso uses workspace gatekeeping for tenant-level exposure of capabilities listed in the operating annex, federation return issues, stale-access cleanup without compromise cues, and workspace-scoped grants. If an annexed capability is already visible and then fails during execution, runtime reliability owns it instead of gatekeeping. Shield response still takes incidents.',
        'The operating annex includes courier dispatch, staged approval lanes, and the batch edit console. Annexed capabilities may still require workspace gatekeeping before they appear in a given tenant.'
    ),
    (
        'FABRIKAM_RETAIL',
        'planning_and_runtime_v6',
        'Fabrikam sends missing capabilities and automation asks to the capability planning board, invoice corrections to the ledger integrity cell, broken existing workflows to runtime reliability, and actual service wind-down to service shaping. Security incidents still go to shield response.',
        'Fabrikam does not currently provision courier dispatch, staged approval lanes, or the batch edit console in the active product bundle.'
    ),
    (
        'NORTHWIND_STUDIO',
        'custodians_and_service_shaping_v6',
        'Northwind uses tenant custodians for stale-access cleanup when there are no compromise cues. External copy rules, spoofed links, credential harvests, and impossible travel escalate to shield response. Package step-downs, satellite shutdown, and nonreserved workspace closure go to service shaping. Runtime malfunctions stay with runtime reliability.',
        'Northwind treats nonreserved sidecar or satellite workspace closure as service reduction rather than finance reconciliation. Northwind does not currently provision courier dispatch, staged approval lanes, or the batch edit console.'
    )
AS t(
    COMPANY_NAME,
    POLICY_PROFILE,
    POLICY_TEXT,
    ENTITLEMENT_TEXT
);


